#!/usr/bin/env bash
################################################################################
#
# Configure script for Petit-Ami
#
# Checks that the tools and the development packages the build needs are on
# the machine, and installs the packages that are missing. The required set is
# what the default "make" target links against; the optional set is what the
# regression tests and the manual build use, which is reported but not
# installed.
#
# Options:
#
# --check   Report what is missing and install nothing.
# --help    Print this.
#
################################################################################

check="0"
for var in "$@"
do

    case "$var" in

    --check) check="1" ;;
    --help)

        echo "Configure program for Petit-Ami"
        echo
        echo "configure [--check]"
        echo
        echo "Checks for the tools and development packages the build needs and"
        echo "installs the missing packages. --check reports and installs nothing."
        exit 0
        ;;

    *)

        echo "*** Option not recognized: $var"
        echo "Terminating"
        exit 1
        ;;

    esac

done

################################################################################
#
# Routines
#

#
# Check command exists
#
# Uses the bash "command" built in. Adds the name to the missing tools list.
#
function checkexists {

    if ! command -v "$1" >/dev/null 2>&1 ; then

        echo "*** No $1 was found"
        missingtools="$missingtools $1"

    fi

}

#
# Check a package is installed, by the host's package manager. Adds the name
# to the list given (required or optional) when it is not.
#
function checkpkg {

    case "$host" in

    linux)

        if dpkg -s "$1" 2>/dev/null | grep -q '^Status: .* installed' ; then return 0; fi
        ;;

    bsd)

        if pkg info -e "$1" 2>/dev/null ; then return 0; fi
        ;;

    mac)

        if [ -n "$brew" ] && "$brew" list --versions "$1" >/dev/null 2>&1 ; then return 0; fi
        ;;

    esac
    return 1

}

################################################################################
#
# Set default variables
#
if [ "$(uname)" = "Linux" ]
then

    compiler="gcc"
    bits="64"
    host="linux"

elif [ "$(uname)" = "FreeBSD" ]
then

    compiler="clang"
    bits="64"
    host="bsd"

elif [ "$(uname)" = "Darwin" ]
then

    compiler="clang"
    bits="64"
    host="mac"

    #
    # Packages come from Homebrew. The Makefile finds them through
    # /opt/homebrew/bin/brew, so look there when brew is not on the path.
    #
    brew="$(command -v brew)"
    if [ -z "$brew" ] && [ -x /opt/homebrew/bin/brew ] ; then brew="/opt/homebrew/bin/brew"; fi

else

    echo "*** Supported operating system not found"
    exit 1

fi

################################################################################
#
# The packages the build needs.
#
# Required: what the default make target compiles and links against. Each is
# the development package, carrying the headers and the link library.
#
# Optional: what the regression tests and the manual use. The terminal tests
# run in an xterm on a private Xvfb; doc/mkpdf renders the manual with
# LibreOffice.
#
if [ "$host" = "linux" ]
then

    required="build-essential pkgconf
              libssl-dev
              libasound2-dev libfluidsynth-dev
              libpng-dev zlib1g-dev
              libfreetype-dev libfontconfig-dev
              libx11-dev libxext-dev libxtst-dev
              libwayland-dev libxkbcommon-dev"
    optional="xvfb xterm libreoffice-writer"

elif [ "$host" = "bsd" ]
then

    required="gmake pkgconf
              openssl
              alsa-lib fluidsynth
              png
              freetype2 fontconfig
              libX11 libXext libXtst
              wayland libxkbcommon"
    optional="xorg-vfbserver xterm libreoffice"

elif [ "$host" = "mac" ]
then

    # The rest of the build is the system frameworks, from Xcode
    required="openssl@3 freetype"
    optional=""

fi

################################################################################
#
# Find what is missing
#
missingreq=""
missingopt=""
missingtools=""

for p in $required
do

    if ! checkpkg "$p" ; then missingreq="$missingreq $p"; fi

done

for p in $optional
do

    if ! checkpkg "$p" ; then missingopt="$missingopt $p"; fi

done

################################################################################
#
# Install the required packages that are missing, or say what they are
#
if [ -n "$missingreq" ]
then

    echo "Required packages not installed:$missingreq"
    if [ "$check" = "1" ]
    then

        echo "Install them with:"
        if [ "$host" = "linux" ] ; then echo "    sudo apt-get install$missingreq"
        elif [ "$host" = "mac" ] ; then echo "    brew install$missingreq"
        else echo "    sudo pkg install$missingreq"
        fi

    elif [ "$host" = "linux" ]
    then

        sudo apt-get install -y $missingreq || installfailed="1"

    elif [ "$host" = "mac" ]
    then

        #
        # Homebrew installs as the user, never with sudo
        #
        if [ -z "$brew" ]
        then

            echo "*** Homebrew was not found. Install it from https://brew.sh, then"
            echo "    run configure again."
            exit 1

        fi
        "$brew" install $missingreq || installfailed="1"

    else

        sudo pkg install -y $missingreq || installfailed="1"

    fi

    if [ "$installfailed" = "1" ]
    then

        echo "*** Aborting: the package install failed"
        exit 1

    fi

else

    echo "All required packages are installed"

fi

if [ -n "$missingopt" ]
then

    echo "Optional packages not installed (tests and manual):$missingopt"

fi

################################################################################
#
# Determine if needed programs exist. The only fatal one is the C compiler,
# because we need that to compile Petit-Ami. The rest will impact the running
# of various test and build scripts.
#
checkexists grep
checkexists diff
checkexists sed
checkexists rm
checkexists cp
checkexists mv
checkexists ls
checkexists tar
checkexists make
checkexists ar
if [ "$host" != "mac" ] ; then checkexists pkg-config; fi

#
# Fail on no C compiler found
#
if ! command -v "$compiler" >/dev/null 2>&1 ; then

    echo "*** Aborting: cannot complete without known C compiler ($compiler)"
    exit 1

fi

if [ -n "$missingreq" ] && [ "$check" = "1" ]
then

    echo "Configure found missing packages"
    exit 1

fi

echo "Configure completed!"
