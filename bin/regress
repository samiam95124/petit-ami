#!/bin/bash
#
# Run the Petit-Ami regression tests
#
# Execution:
#
# regress [--update] [<test>...]
#
# Runs each of the self-contained tests, captures the output as
# tests/<test>.lst, and compares it against the golden file tests/<test>.cmp
# using dif -q, which treats '?' in either file as a wildcard matching any
# single character. Fields that legitimately change from run to run (times,
# dates) are masked with '?' in the .cmp files. Differences are left in
# tests/<test>.dif; a test passes when its .dif file is empty.
#
# Options:
#
# --update  Regenerate the .cmp files from a fresh run, with the standard
#           masks applied. Use after an intentional output change, then
#           inspect the new .cmp files before committing them.
#
# With no test arguments, all tests are run. Returns the number of failing
# tests, so 0 means a pass.
#
# Some text standards are of a platform's paths, environment, option character
# and directory listing, and no mask covers that, so those tests keep a
# standard per platform, in the platform's own directory:
# tests/windows_compare/<test>.cmp, tests/linux_compare/<test>.cmp,
# tests/macosx_compare/<test>.cmp. The tests that do are listed in plattests
# below; the rest share one standard across the platforms, tests/<test>.cmp.
#
# The print tests, txttest and pdftest, print into a file, and that is what
# is compared: the text page, tests/txttest.lst, by dif; the document,
# tests/pdftest.pdf, whole, and named so that a reader opens it.
# Neither carries a date or anything else that varies from run to run, and the
# .pdf sets its text in the standard PDF fonts, whose metrics are the module's
# own, so one standard serves every platform.
#
# The picture standards are of a desktop's look -- the frame the screen tests
# size themselves against, the menus, the theme -- so they live in the
# platform's directory too, and on Linux, where GNOME and Plasma draw through
# different decoration modules, each desktop keeps a set of its own:
# tests/linux_compare/<test>.gnome.cmp and tests/linux_compare/<test>.plasma.cmp.
# The set is chosen the way the decorations choose themselves, from
# XDG_CURRENT_DESKTOP, and a desktop that has no set yet is told to make one
# with --update. Windows and Mac OS X draw one look each:
# tests/windows_compare/<test>.cmp, tests/macosx_compare/<test>.cmp.
#
# A picture run that fails is kept as tests/<test>.fail-<stamp>.lst, so the
# screens that differed survive the re-run that overwrites the .lst.
#
# The _testr tests are the same picture tests run remotely: the client links
# graph_client and draws through a graph_server this script starts on this
# machine (port 4909, so a server of yours on the default port is untouched).
# The display is the server's, so there are no captures to compare; a remote
# run passes when it walks every pattern and exits clean with nothing on the
# error channel.
#
# Notes:
#
# The test binaries load the Petit-Ami shared libraries relative to the
# current directory, so everything runs from the repository root, except
# services_test: it lists the current directory, so it runs in the fixed
# sandbox tests/regress (which carries a lib symlink for the loader).
# services_test also prints environment and locale state, so it runs under a
# controlled minimal environment. The .cmp files still contain some machine
# specific text (home paths, country, timezone); regenerate them with
# --update when moving to a new machine, then review the result. The
# picture standards are machine specific throughout -- they are pictures of
# this screen, at this size, in these fonts -- so they always want
# regenerating on a new machine.
#

# find repository root from this script's location and work there
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1

# the platform: it names the directory of the standards that are the
# platform's own, and the programs. plat is set where the platform is not a
# Unix; the Unix ports name their programs alike.
case "$(uname -s)" in

MINGW*|MSYS*|CYGWIN*) plat="windows"; cmpdir="tests/windows_compare" ;;
Darwin)               plat="";        cmpdir="tests/macosx_compare" ;;
FreeBSD)              plat="";        cmpdir="tests/freebsd_compare" ;;
*)                    plat="";        cmpdir="tests/linux_compare" ;;

esac
plattests=" services_test "

# The test's program. Windows names it with .exe, and a same-named file of
# another platform's, such as a Linux build left in bin, must not stand for
# it.
binof()
{

    if [ -n "$plat" ]; then echo "bin/$1.exe"; else echo "bin/$1"; fi

}

# The test's output file: the listing, except for the document, which takes
# the name a reader opens.
outof()
{

    case "$1" in
    pdftest) echo "tests/$1.pdf" ;;
    *)       echo "tests/$1.lst" ;;
    esac

}

update="0"
tests=""
for arg in "$@"; do

    if [ "$arg" = "--update" ]; then update="1"
    else tests="$tests $arg"
    fi

done
if [ -z "$tests" ]; then

    tests="stdio_test services_test network_test txttest pdftest \
           graphics_test management_test widget_test \
           graphics_testr management_testr widget_testr"

fi

#
# Mask run-varying fields. Applied when regenerating .cmp files. Fixed width
# fields are masked with '?' (one per character); fields whose width can
# change from run to run, like the process id in temp file names, are masked
# with '*', which dif -q matches against any run of characters.
#
# - dates: yyyy/mm/dd and dd/mm/yyyy (or mm/dd/yyyy) forms
# - times: hh:mm:ss with optional " am"/" pm" suffix. The suffix presence
#   varies with the time of day (12 hour locales suffix only pm times), so
#   the line width varies run to run and the whole time is masked with '*'
# - elapsed tick counts on the "test 11:" line of services_test
# - temp file names from stdio_test: the directory, which is the platform's,
#   and the process id; and the length of such a name, which grows with the
#   digits in the pid
# - the largest loopback message in network_test, which is the loopback
#   route's MTU less the headers and so the platform's: Linux offers 65488
#   over v6 where Windows offers 65487
# - the daylight savings flag, which changes with the season. The timezone
#   offset is not masked: it is a fixed property of the machine's zone now
#   that ami_timezone handles the day wrap
#
mask()
{

    sed -E \
        -e 's|[0-9]{4}/[0-9]{2}/[0-9]{2}|????/??/??|g' \
        -e 's|[0-9]{2}/[0-9]{2}/[0-9]{4}|??/??/????|g' \
        -e 's|[0-9]{2}:[0-9]{2}:[0-9]{2}( [ap]m)?|*|g' \
        -e 's|^(test 11: )[0-9]+|\1*|' \
        -e 's|"[^"]*tmp\.[0-9]+\.([12])"|"*tmp.*.\1"|g' \
        -e 's|^(test 702: 1 s/b 1 \(length )[0-9]+|\1*|' \
        -e 's|^(test 59: Daysave: )[0-9]+|\1*|' \
        -e 's|^(    maximum message for (v6 )?loopback: )[0-9]+|\1*|' \
        -e 's|^(    sent )[0-9]+( bytes \(the maxmsg(v6)? limit\), server received )[0-9]+|\1*\2*|' \
        -e 's|^(    google.com A    -> ).*|\1*|' \
        -e 's|^(    google.com AAAA -> ).*|\1*|'

}

#
# The remote display server, started once when the first remote test wants
# it, on a port of its own; killed by pid on the way out, never by name.
#
rport=4909
rsrvpid=""

startrsrv()
{

    if [ -z "$rsrvpid" ]; then

        GRAPH_PORT=$rport "$(binof graph_server)" > /dev/null 2>&1 &
        rsrvpid=$!
        sleep 2

    fi

}

stoprsrv()
{

    if [ -n "$rsrvpid" ]; then

        kill "$rsrvpid" 2> /dev/null
        wait "$rsrvpid" 2> /dev/null
        rsrvpid=""

    fi

}

#
# Run one test, output to the named .lst file
#
runtest()
{

    case "$1" in

    services_test)
        # fixed sandbox for the directory listing; controlled environment;
        # PATH carries the repository bin for the exec tests. Windows names
        # the user in USERNAME.
        user="${USER:-$USERNAME}"
        (cd tests/regress && \
         env -i HOME="$HOME" USER="$user" LOGNAME="$user" \
             PATH="$root/bin:/usr/local/bin:/usr/bin:/bin" \
             LANG="en_US.UTF-8" \
             timeout 300 "$root/$(binof "$1")" < /dev/null) \
             > "tests/$1.lst" 2>&1
        ;;

    graphics_testr|management_testr|widget_testr)
        # the same walk, drawn through the remote server on this machine
        startrsrv
        GRAPH_PORT=$rport timeout 300 "$(binof "$1")" auto < /dev/null \
            > "tests/$1.out" 2>&1
        remoterc=$?
        ;;

    txttest|pdftest)
        # the printer is a file: the document is the listing
        rm -f "$(outof "$1")"
        timeout 300 "$(binof "$1")" "$(outof "$1")" < /dev/null \
            > "tests/$1.out" 2>&1
        ;;
    graphics_test|management_test|widget_test)
        # "auto" walks every screen without waiting for a keypress. What
        # these tests produce is not text but the screens themselves: the
        # capture module appends each to the file named after it, and that
        # file is the listing they are judged on. Each test is given its
        # own, so two runs beside each other do not write over one another.
        rm -f "tests/$1.lst"
        timeout 300 "$(binof "$1")" auto "tests/$1.lst" < /dev/null \
            > "tests/$1.out" 2>&1
        ;;

    *)
        timeout 300 "$(binof "$1")" < /dev/null > "tests/$1.lst" 2>&1
        ;;

    esac

}

# the PNG signature, for counting the screens in a capture stream
pngsig=$(printf '\211PNG')

# the desktop the screens are drawn in, which qualifies the picture
# standards on Linux; the other platforms draw one look each
case "$(uname -s)" in

MINGW*|MSYS*|CYGWIN*|Darwin) desk="" ;;
*) case "$XDG_CURRENT_DESKTOP" in
   *KDE*) desk=".plasma" ;;
   *)     desk=".gnome" ;;
   esac ;;

esac

fails=0
for t in $tests; do

    if [ ! -x "$(binof "$t")" ]; then

        echo "$t: no $(binof "$t"), run make first"
        fails=$((fails+1))
        continue

    fi
    case "$t" in

    graphics_test|management_test|widget_test)    pict=1; remote=0; whole=0 ;;
    graphics_testr|management_testr|widget_testr) pict=1; remote=1; whole=0 ;;
    pdftest)                                      pict=0; remote=0; whole=1 ;;
    *)                                            pict=0; remote=0; whole=0 ;;

    esac
    if [ "$pict" = "1" ] && [ -z "$plat" ] && \
       [ -z "$WAYLAND_DISPLAY" ] && [ -z "$DISPLAY" ]; then

        # it draws on a screen, and there is none here; Windows always has one
        echo "$t: skipped, no display"
        continue

    fi
    if [ "$remote" = "1" ] && [ ! -x "$(binof graph_server)" ]; then

        echo "$t: no $(binof graph_server), run make first"
        fails=$((fails+1))
        continue

    fi
    runtest "$t"
    if [ "$remote" = "1" ]; then

        # no pictures to compare: the display is the server's. The run
        # passes when it walks out clean and says nothing on the way.
        if [ "$remoterc" = "0" ] && [ ! -s "tests/$t.out" ]; then

            rm -f "tests/$t.dif"
            echo "$t: pass"

        else

            {
                echo "remote run failed: exit $remoterc"
                echo "client output:"
                cat "tests/$t.out"
            } > "tests/$t.dif"
            echo "$t: *** fail *** (see tests/$t.dif)"
            fails=$((fails+1))

        fi
        continue

    fi
    if [ "$pict" = "1" ]; then

        # a stream of PNGs: compared whole, since a picture has no fields
        # that vary from run to run to be masked
        if [ ! -f "tests/$t.lst" ]; then

            echo "$t: *** fail *** (no test_images produced)"
            fails=$((fails+1))
            continue

        fi
        std="$cmpdir/$t$desk.cmp"
        if [ "$update" = "1" ]; then

            cp "tests/$t.lst" "$std"
            echo "$t: $std regenerated, please review with bin/testviewer"

        elif [ ! -f "$std" ]; then

            {
                echo "no $std: this platform${desk:+ and desktop} has no standard for $t yet"
                echo "make one with: bin/regress --update $t, then review it"
            } > "tests/$t.dif"
            echo "$t: *** fail *** (see tests/$t.dif)"
            fails=$((fails+1))

        elif cmp -s "tests/$t.lst" "$std"; then

            rm -f "tests/$t.dif"
            echo "$t: pass"

        else

            # the run is kept aside, so the screens that differed survive
            # the re-run that overwrites the .lst
            keep="tests/$t.fail-$(date +%Y%m%d-%H%M%S).lst"
            cp "tests/$t.lst" "$keep"
            {
                echo "screens differ from $std"
                echo "standard: $(wc -c < "$std") bytes,\
 $(grep -a -o "$pngsig" "$std" | wc -l) screens"
                echo "this run: $(wc -c < "tests/$t.lst") bytes,\
 $(grep -a -o "$pngsig" "tests/$t.lst" | wc -l) screens"
                cmp "$std" "tests/$t.lst" 2>&1
                echo "this run kept as $keep"
                echo "view either with: bin/testviewer <file>"
            } > "tests/$t.dif"
            echo "$t: *** fail *** (see tests/$t.dif, run kept as $keep)"
            fails=$((fails+1))

        fi
        continue

    fi
    # the standard: this platform's own where the test keeps one per platform
    std="tests/$t.cmp"
    case "$plattests" in
    *" $t "*) std="$cmpdir/$t.cmp" ;;
    esac
    out="$(outof "$t")"
    if [ ! -f "$out" ]; then

        echo "$t: *** fail *** (no output produced)"
        fails=$((fails+1))
        continue

    fi
    if [ "$whole" = "1" ]; then

        # a document compared whole: nothing in it wants masking
        if [ "$update" = "1" ]; then
            cp "$out" "$std"
            echo "$t: $std regenerated, please review"
        elif [ ! -f "$std" ]; then
            {
                echo "no $std: there is no standard for $t yet"
                echo "make one with: bin/regress --update $t, then review it"
            } > "tests/$t.dif"
            echo "$t: *** fail *** (see tests/$t.dif)"
            fails=$((fails+1))
        elif cmp -s "$out" "$std"; then
            rm -f "tests/$t.dif"
            echo "$t: pass"
        else
            {
                echo "document differs from $std"
                cmp "$std" "$out" 2>&1
            } > "tests/$t.dif"
            echo "$t: *** fail *** (see tests/$t.dif)"
            fails=$((fails+1))
        fi
        continue

    fi
    if [ "$update" = "1" ]; then

        mask < "tests/$t.lst" > "$std"
        echo "$t: $std regenerated, please review"

    elif [ ! -f "$std" ]; then

        {
            echo "no $std: this platform has no standard for $t yet"
            echo "make one with: bin/regress --update $t, then review it"
        } > "tests/$t.dif"
        echo "$t: *** fail *** (see tests/$t.dif)"
        fails=$((fails+1))

    else

        bin/dif -q "tests/$t.lst" "$std" > "tests/$t.dif"
        if [ -s "tests/$t.dif" ]; then

            echo "$t: *** fail *** (see tests/$t.dif)"
            fails=$((fails+1))

        else

            echo "$t: pass"

        fi

    fi

done

stoprsrv
exit $fails
